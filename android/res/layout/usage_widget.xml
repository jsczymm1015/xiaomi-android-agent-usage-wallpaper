<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:background="#000000">
  <ImageView android:id="@+id/usage_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Agent 剩余额度、每日用量与可用重置卡及最近到期时间，点击更换人物" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="18" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="272" android:orientation="vertical">
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="14" />
      <ViewFlipper android:id="@+id/usage_motion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="272" android:autoStart="true" android:flipInterval="100" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="134" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="610" />
  </LinearLayout>
</FrameLayout>
